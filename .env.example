# Copy this file to a new file called .env and fill in your own details.
# The .env file stays on your laptop and is never uploaded to GitHub.

# MusicBrainz asks every app to say who is calling, with a way to reach them.
# Put your email address or your GitHub profile link here.
MB_CONTACT=

# Spotify: from your app at developer.spotify.com/dashboard (Settings).
# The secret works like a password, so it only ever lives in .env.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
